# ViennaGeoAI application
APP_PORT=8080
POGEO_ENVIRONMENT=development
POGEO_REF=master

# Local Ollama daemon on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=300

# Geospatial limits
WFS_TIMEOUT_SECONDS=30
MAX_FEATURES=5000
MAX_TOOL_ITERATIONS=6

# Local development database used by the PoGeo runtime
POSTGRES_PASSWORD=pogeo
