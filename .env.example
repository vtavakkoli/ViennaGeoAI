# ViennaGeoAI application
APP_PORT=8080
POGEO_ENVIRONMENT=development

# Verified PoGeo revision with WFS 1.1 CRS-qualified BBOX support.
# Bump deliberately when adopting a newer tested PoGeo commit.
POGEO_REF=f3d4e02f2415182b9a85f9cf6a00be1209d047b1

# Local Ollama daemon on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=300

# Geospatial limits
WFS_TIMEOUT_SECONDS=30
MAX_FEATURES=5000
MAX_TOOL_ITERATIONS=6

# Local development database used by the PoGeo runtime
POSTGRES_PASSWORD=pogeo
